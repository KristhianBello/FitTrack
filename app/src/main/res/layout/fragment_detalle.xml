<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_metric"
    tools:context=".DetalleFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título de la página -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/control_peso"
            android:textSize="24sp"
            android:textColor="@color/track_night"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!--Tarjetas superiores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Tarjeta Peso Actual -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/clean_stat"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/peso_actual"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_peso_actual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/peso_placeholder"
                        android:textSize="20sp"
                        android:textColor="@color/fit_glow"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Tarjeta Meta -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/clean_stat"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meta"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_peso_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meta_placeholder"
                        android:textSize="20sp"
                        android:textColor="@color/track_night"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Gráfico de Evolución -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/clean_stat"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mi_evolucion"
                    android:textSize="18sp"
                    android:textColor="@color/track_night"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Aquí irá el gráfico real, por ahora placeholder -->
                <FrameLayout
                    android:id="@+id/chart_container"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/chart_placeholder_background">

                    <!-- Placeholder para el gráfico -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/grafico_evolucion_placeholder"
                        android:gravity="center"
                        android:textColor="@color/fit_glow"
                        android:textStyle="italic" />

                </FrameLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Botón de Acción -->
        <Button
            android:id="@+id/btn_registrar_peso"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_primary"
            android:text="@string/registrar_peso_hoy"
            android:textColor="@color/clean_stat"
            android:textStyle="bold"
            android:textSize="16sp"
            android:elevation="2dp" />

        <!-- Tarjeta de Ingreso de Peso (inicialmente oculta) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_ingreso_peso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/clean_stat"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrar Nuevo Peso"
                    android:textSize="18sp"
                    android:textColor="@color/track_night"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Peso (kg)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_nuevo_peso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <Button
                        android:id="@+id/btn_cancelar_ingreso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cancelar"
                        android:textColor="@color/track_night"
                        android:background="?attr/selectableItemBackground"
                        android:layout_marginEnd="8dp"
                        style="?attr/borderlessButtonStyle" />

                    <Button
                        android:id="@+id/btn_guardar_peso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Guardar"
                        android:textColor="@color/clean_stat"
                        android:background="@drawable/button_primary" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Últimos Registros -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/clean_stat"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ultimos_registros"
                    android:textSize="18sp"
                    android:textColor="@color/track_night"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Registro 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_registro1_fecha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/registro1_fecha"
                        android:textSize="14sp"
                        android:textColor="@color/soft_metric" />

                    <TextView
                        android:id="@+id/tv_registro1_peso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/registro1_peso"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_editar_registro1"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Editar"
                        android:textSize="12sp"
                        android:textColor="@color/fit_glow"
                        android:background="?attr/selectableItemBackground"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        style="?attr/borderlessButtonStyle" />

                </LinearLayout>

                <!-- Registro 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_registro2_fecha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/registro2_fecha"
                        android:textSize="14sp"
                        android:textColor="@color/soft_metric" />

                    <TextView
                        android:id="@+id/tv_registro2_peso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/registro2_peso"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_editar_registro2"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Editar"
                        android:textSize="12sp"
                        android:textColor="@color/fit_glow"
                        android:background="?attr/selectableItemBackground"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        style="?attr/borderlessButtonStyle" />

                </LinearLayout>

                <!-- Registro 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_registro3_fecha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/registro3_fecha"
                        android:textSize="14sp"
                        android:textColor="@color/soft_metric" />

                    <TextView
                        android:id="@+id/tv_registro3_peso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/registro3_peso"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_editar_registro3"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Editar"
                        android:textSize="12sp"
                        android:textColor="@color/fit_glow"
                        android:background="?attr/selectableItemBackground"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        style="?attr/borderlessButtonStyle" />

                </LinearLayout>

                <!-- Registro 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_registro4_fecha"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/registro4_fecha"
                        android:textSize="14sp"
                        android:textColor="@color/soft_metric" />

                    <TextView
                        android:id="@+id/tv_registro4_peso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/registro4_peso"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_editar_registro4"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Editar"
                        android:textSize="12sp"
                        android:textColor="@color/fit_glow"
                        android:background="?attr/selectableItemBackground"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        style="?attr/borderlessButtonStyle" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
