<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_metric"
    tools:context=".DetalleFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título de la página -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Control de Peso"
            android:textSize="24sp"
            android:textColor="@color/track_night"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Métricas Clave - Tarjetas superiores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Tarjeta Peso Actual -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/clean_stat"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peso Actual"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_peso_actual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85.5 kg"
                        android:textSize="20sp"
                        android:textColor="@color/fit_glow"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Tarjeta Meta -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/clean_stat"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meta"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_peso_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80.0 kg"
                        android:textSize="20sp"
                        android:textColor="@color/track_night"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Gráfico de Evolución -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/clean_stat"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi Evolución"
                    android:textSize="18sp"
                    android:textColor="@color/track_night"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Aquí iría el gráfico real, por ahora placeholder -->
                <FrameLayout
                    android:id="@+id/chart_container"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/chart_placeholder_background">

                    <!-- Placeholder para el gráfico -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Gráfico de Evolución\n(Línea en Cian Brillante)"
                        android:gravity="center"
                        android:textColor="@color/fit_glow"
                        android:textStyle="italic" />

                </FrameLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Botón de Acción -->
        <Button
            android:id="@+id/btn_registrar_peso"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/button_primary"
            android:text="REGISTRAR PESO HOY"
            android:textColor="@color/clean_stat"
            android:textStyle="bold"
            android:textSize="16sp"
            android:elevation="2dp" />

        <!-- Últimos Registros -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/clean_stat"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Últimos Registros"
                    android:textSize="18sp"
                    android:textColor="@color/track_night"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Registro 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="20 Nov 2024"
                        android:textSize="14sp"
                        android:textColor="@color/soft_metric" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85.5 kg"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Registro 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="18 Nov 2024"
                        android:textSize="14sp"
                        android:textColor="@color/soft_metric" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85.8 kg"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Registro 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="15 Nov 2024"
                        android:textSize="14sp"
                        android:textColor="@color/soft_metric" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="86.2 kg"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Registro 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="12 Nov 2024"
                        android:textSize="14sp"
                        android:textColor="@color/soft_metric" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="86.5 kg"
                        android:textSize="14sp"
                        android:textColor="@color/track_night"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
