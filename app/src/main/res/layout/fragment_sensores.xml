<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white"
    tools:context=".SensoresFragment">

    <!-- Título Principal -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sensores_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/track_night"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- ScrollView para múltiples sensores -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Sensor de Proximidad -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"
                android:backgroundTint="@color/clean_stat"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Sensor de Proximidad"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/track_night"
                        android:layout_marginBottom="12dp" />

                    <ProgressBar
                        android:id="@+id/progressProximidad"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:max="100"
                        android:progress="0"
                        android:layout_marginBottom="12dp"
                        android:progressDrawable="@drawable/progress_bar_proximidad" />

                    <TextView
                        android:id="@+id/textProximidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/fit_glow"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Sensor de Luz (SEPARADO) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"
                android:backgroundTint="@color/clean_stat"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Sensor de Luz"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/track_night"
                        android:layout_marginBottom="12dp" />

                    <ProgressBar
                        android:id="@+id/progressLuz"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:max="100"
                        android:progress="0"
                        android:layout_marginBottom="12dp"
                        android:progressDrawable="@drawable/progress_bar_luz" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/textLuz"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="14sp"
                            android:textColor="@color/fit_glow"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textLuzDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌙 Muy oscuro"
                            android:textSize="14sp"
                            android:textStyle="italic"
                            android:textColor="@color/track_night"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Detector de Sacudidas -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardShake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"
                android:backgroundTint="@color/clean_stat"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:id="@+id/shakeContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@android:color/white">

                    <TextView
                        android:id="@+id/textShakeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="🎯 Detector de Sacudida"
                        android:textColor="@color/track_night"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textShake"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Agita tu dispositivo..."
                        android:textColor="@color/track_night"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Acelerómetro COMBINADA - X, Y, Z (SEPARADO) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"
                android:backgroundTint="@color/clean_stat"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Título General -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="📱 Acelerómetro (X, Y, Z)"
                        android:textColor="@color/track_night"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Eje X - Verde -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Eje X (Verde)"
                            android:textColor="@color/track_night"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progressAcelX"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_x" />

                        <TextView
                            android:id="@+id/textAcelX"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/fit_glow"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Eje Y - Azul -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Eje Y (Azul)"
                            android:textColor="@color/track_night"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progressAcelY"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_y" />

                        <TextView
                            android:id="@+id/textAcelY"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/fit_glow"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Eje Z - Rojo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Eje Z (Rojo)"
                            android:textColor="@color/track_night"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progressAcelZ"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_z" />

                        <TextView
                            android:id="@+id/textAcelZ"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/fit_glow"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Separador visual -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/soft_metric" />

                    <!-- Magnitud Total dentro del acelerómetro -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="📊 Magnitud:"
                            android:textColor="@color/track_night"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textMagnitud"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 m/s²"
                            android:textColor="@color/fit_glow"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>

