<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_metric"
    tools:context=".RutinaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Pestañas de Navegación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/clean_stat"
            android:elevation="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Pestaña Mis Rutinas (Activa) -->
            <LinearLayout
                android:id="@+id/tabMisRutinas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/textMisRutinas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mis Rutinas"
                    android:textSize="16sp"
                    android:textColor="@color/fit_glow"
                    android:textStyle="bold" />

                <!-- Línea indicadora activa -->
                <View
                    android:id="@+id/lineMisRutinas"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/fit_glow" />

            </LinearLayout>

            <!-- Pestaña Historial (Inactiva) -->
            <LinearLayout
                android:id="@+id/tabHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/textHistorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Historial"
                    android:textSize="16sp"
                    android:textColor="@color/track_night"
                    android:alpha="0.6" />

                <!-- Línea indicadora inactiva (invisible) -->
                <View
                    android:id="@+id/lineHistorial"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:visibility="invisible" />

            </LinearLayout>

        </LinearLayout>

        <!-- Contenido Principal - Lista de Rutinas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewRutinas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:visibility="visible"
            android:scrollbars="vertical" />

        <!-- Contenido Alternativo - Historial (Oculto inicialmente) -->
        <ScrollView
            android:id="@+id/scrollHistorial"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Historial de Entrenamientos"
                    android:textSize="18sp"
                    android:textColor="@color/track_night"
                    android:textStyle="bold"
                    android:layout_marginTop="32dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Próximamente disponible"
                    android:textSize="14sp"
                    android:textColor="@color/track_night"
                    android:alpha="0.7"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </ScrollView>

        <!-- Lista estática de rutinas para demostración -->
        <ScrollView
            android:id="@+id/scrollMisRutinas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Tarjeta Rutina 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:backgroundTint="@color/clean_stat"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <!-- Información principal -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Full Body Día 1"
                                android:textSize="18sp"
                                android:textColor="@color/track_night"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30 min • 6 Ejercicios"
                                android:textSize="14sp"
                                android:textColor="@color/track_night"
                                android:alpha="0.7" />

                        </LinearLayout>

                        <!-- Indicador frecuencia -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3x/Semana"
                            android:textSize="12sp"
                            android:textColor="@color/fit_glow"
                            android:textStyle="bold"
                            android:background="@drawable/frequency_badge"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_gravity="center_vertical" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Tarjeta Rutina 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:backgroundTint="@color/clean_stat"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pecho y Tríceps"
                                android:textSize="18sp"
                                android:textColor="@color/track_night"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45 min • 8 Ejercicios"
                                android:textSize="14sp"
                                android:textColor="@color/track_night"
                                android:alpha="0.7" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2x/Semana"
                            android:textSize="12sp"
                            android:textColor="@color/fit_glow"
                            android:textStyle="bold"
                            android:background="@drawable/frequency_badge"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_gravity="center_vertical" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Tarjeta Rutina 3 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:backgroundTint="@color/clean_stat"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Espalda y Bíceps"
                                android:textSize="18sp"
                                android:textColor="@color/track_night"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="40 min • 7 Ejercicios"
                                android:textSize="14sp"
                                android:textColor="@color/track_night"
                                android:alpha="0.7" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2x/Semana"
                            android:textSize="12sp"
                            android:textColor="@color/fit_glow"
                            android:textStyle="bold"
                            android:background="@drawable/frequency_badge"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_gravity="center_vertical" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Tarjeta Rutina 4 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="80dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:backgroundTint="@color/clean_stat"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Piernas Completas"
                                android:textSize="18sp"
                                android:textColor="@color/track_night"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="50 min • 9 Ejercicios"
                                android:textSize="14sp"
                                android:textColor="@color/track_night"
                                android:alpha="0.7" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1x/Semana"
                            android:textSize="12sp"
                            android:textColor="@color/fit_glow"
                            android:textStyle="bold"
                            android:background="@drawable/frequency_badge"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:layout_gravity="center_vertical" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Floating Action Button (FAB) - Principal -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddRutina"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="100dp"
        android:backgroundTint="@color/progress_neon"
        android:src="@android:drawable/ic_input_add"
        app:tint="@color/clean_stat"
        app:elevation="8dp"
        app:fabSize="normal"
        android:contentDescription="Agregar nueva rutina" />

    <!-- FAB Backup con configuración alternativa para debug -->
    <TextView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/debug_fab_background"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/clean_stat"
        android:textSize="24sp"
        android:textStyle="bold"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true"
        android:id="@+id/debugFab" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
