<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.FitTrack" parent="Theme.Material3.DayNight">
        <!-- Colores principales usando la nueva paleta -->
        <item name="colorPrimary">@color/track_night</item>
        <item name="colorOnPrimary">@color/clean_stat</item>
        <item name="colorPrimaryVariant">@color/track_night</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/fit_glow</item>
        <item name="colorOnSecondary">@color/track_night</item>
        <item name="colorSecondaryVariant">@color/progress_neon</item>

        <!-- Colores de superficie y fondo -->
        <item name="colorSurface">@color/clean_stat</item>
        <item name="colorOnSurface">@color/track_night</item>
        <item name="android:colorBackground">@color/soft_metric</item>
        <item name="colorOnBackground">@color/track_night</item>

        <!-- Colores de acento -->
        <item name="colorAccent">@color/fit_glow</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/track_night</item>
        <item name="android:navigationBarColor">@color/clean_stat</item>

        <!-- Disable default ActionBar to use custom Toolbar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Estilo personalizado para el indicador activo del BottomNavigationView -->
    <style name="CustomBottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">40dp</item>
        <item name="android:height">40dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">24dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:drawable">@drawable/bottom_nav_active_indicator</item>
    </style>
</resources>