    <!-- Nuevos colores FitTrack -->
    <!-- Azul Oscuro/Navy - "Track Night" - Principal/Base -->
    <color name="track_night">#0C2B5B</color>
    <color name="primary">#0C2B5B</color>

    <!-- Cian/Turquesa Brillante - "Fit Glow" - Acento/Primario -->
    <color name="fit_glow">#00C2E0</color>
    <color name="accent_primary">#00C2E0</color>

    <!-- Verde Neón/Lima - "Progress Neon" - Acento/Secundario -->
    <color name="progress_neon">#A7F000</color>
    <color name="accent_secondary">#A7F000</color>

    <!-- Blanco - "Clean Stat" - Texto/Fondo Secundario -->
    <color name="clean_stat">#FFFFFF</color>

    <!-- Gris Claro - "Soft Metric" - Soporte/Contraste Suave -->
    <color name="soft_metric">#C0C0C0</color>

    <!-- Mantenemos lavender como alias para compatibilidad -->
    <color name="lavender">#00C2E0</color>

    <!-- Colores específicos para navegación -->
    <color name="bottom_nav_icon_active">@color/track_night</color>
    <color name="bottom_nav_icon_inactive">@color/fit_glow</color>
    <color name="bottom_nav_text_active">@color/clean_stat</color>
    <color name="bottom_nav_text_inactive">#B3FFFFFF</color> <!-- clean_stat con 70% opacidad -->
